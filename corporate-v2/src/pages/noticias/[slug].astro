---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { newsTypeLabels } from '../../data/news';
import TerritorialGrid from '../../components/TerritorialGrid.astro';
import launchLogo from '../../assets/brand/derived/geotactics-full-light.png';

export async function getStaticPaths() {
	const entries = (await getCollection('news')).filter((e) => e.data.publicationStatus === 'public');
	return entries.map((entry) => ({
		params: { slug: entry.data.slug },
		props: { entry },
	}));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;
---

<BaseLayout
	title={`${d.seoTitle ?? d.title} | GeoTactics`}
	description={d.seoDescription ?? d.summary}
	noindex={false}
>
	<article class="gt-nd gt-container--wide">
		<p class="gt-nd__micro">GT / SIGNALS · {newsTypeLabels[d.type]}</p>
		<h1>{d.title}</h1>
		<p>
			<time datetime={d.date.toISOString()}>
				{d.date.toLocaleDateString('es-EC', { day: 'numeric', month: 'long', year: 'numeric' })}
			</time>
			{d.location ? <span> · {d.location}</span> : null}
		</p>
		<p class="gt-nd__sum">{d.summary}</p>
		{d.heroAsset === 'launch-web-3' ? (
			<figure class="gt-nd__hero-visual">
				<TerritorialGrid intensity="subtle" />
				<img src={launchLogo.src} width={launchLogo.width} height={launchLogo.height} alt="GeoTactics — Data / Warehouse - Mart" />
				<figcaption>GeoTactics Web 3.0 · lanzamiento 25 de septiembre de 2026</figcaption>
			</figure>
		) : null}
		<div class="gt-nd__body">
			<Content />
		</div>
		<p>
			<a href="/noticias">Volver a noticias</a>
		</p>
	</article>
</BaseLayout>

<style>
	.gt-nd {
		padding: var(--gt-space-10) 0 var(--gt-space-12);
		max-width: 48rem;
	}

	.gt-nd__micro {
		font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
		font-size: 0.62rem;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: var(--gt-gray-400);
		margin-bottom: 0.5rem;
	}

	.gt-nd h1 {
		font-size: var(--gt-fs-xl);
		margin-bottom: var(--gt-space-4);
	}

	.gt-nd__sum {
		margin: var(--gt-space-5) 0;
		color: var(--gt-gray-800);
	}

	.gt-nd__hero-visual {
		position: relative;
		min-height: clamp(15rem, 34vw, 24rem);
		margin: var(--gt-space-6) 0 var(--gt-space-8);
		border: 1px solid var(--gt-border);
		background: var(--gt-off-white);
		display: grid;
		place-items: center;
		overflow: hidden;
		isolation: isolate;
	}

	.gt-nd__hero-visual img {
		position: relative;
		z-index: 2;
		width: min(64%, 24rem);
		height: auto;
		mix-blend-mode: multiply;
	}

	.gt-nd__hero-visual figcaption {
		position: absolute;
		z-index: 2;
		left: var(--gt-space-4);
		bottom: var(--gt-space-4);
		margin: 0;
		font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
		font-size: 0.68rem;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		color: var(--gt-coral);
	}

	.gt-nd__body {
		margin-bottom: var(--gt-space-8);
		max-width: 46rem;
	}

	/* Editorial paragraph rhythm.
	   The global reset removes default margins, so rendered Markdown needs
	   explicit spacing to preserve readable paragraphs and section breaks. */
	.gt-nd__body :global(p) {
		margin: 0 0 1.15rem;
		line-height: 1.72;
	}

	.gt-nd__body :global(h2) {
		margin: 2.5rem 0 0.85rem;
		font-size: var(--gt-fs-lg);
		line-height: 1.15;
	}

	.gt-nd__body :global(h3) {
		margin: 2rem 0 0.7rem;
		font-size: 1.08rem;
		line-height: 1.25;
	}

	.gt-nd__body :global(h2 + p),
	.gt-nd__body :global(h3 + p) {
		margin-top: 0;
	}

	.gt-nd__body :global(ul),
	.gt-nd__body :global(ol) {
		margin: 0 0 1.25rem;
		padding-left: 1.25rem;
	}

	.gt-nd__body :global(li + li) {
		margin-top: 0.45rem;
	}

	.gt-nd__body :global(blockquote) {
		margin: 1.75rem 0;
		padding-left: 1rem;
		border-left: 2px solid var(--gt-coral);
	}

	.gt-nd__body :global(blockquote p:last-child),
	.gt-nd__body :global(p:last-child) {
		margin-bottom: 0;
	}
</style>
