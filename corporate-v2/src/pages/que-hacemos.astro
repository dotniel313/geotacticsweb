---
import { getCollection, render } from 'astro:content';
import CapabilityVisual from '../components/CapabilityVisual.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { capabilitiesIntro, conversarHref, copy } from '../config/site';
const entries=(await getCollection('capabilities')).sort((a,b)=>a.data.order-b.data.order);
const rendered=await Promise.all(entries.map(async(entry)=>{const {Content}=await render(entry);return{entry,Content};}));
---
<BaseLayout title="Qué hacemos | GeoTactics" description="Seis familias de problemas que GeoTactics aborda con información, territorio, procesos y tecnología." noindex={false}>
<article class="gt-qh">
<header class="gt-qh__intro gt-container--wide"><p class="gt-qh__micro">{capabilitiesIntro.microcode}</p><h1>Qué hacemos</h1><p class="gt-qh__lead">Partimos del <span class="gt-accent">problema</span>, no de una tecnología predeterminada.</p><p class="gt-qh__support">Trabajamos en seis familias de problemas. Cada una puede combinar <span class="gt-accent">datos, territorio, procesos, software y análisis</span> de manera distinta.</p></header>
<div class="gt-qh__list gt-container--wide">{rendered.map(({entry,Content},index)=><section class="gt-qh__cap" id={entry.data.slug} aria-labelledby={`${entry.data.slug}-title`}><div class="gt-qh__visual" aria-hidden="true"><CapabilityVisual kind={entry.data.visual}/></div><div class="gt-qh__copy"><p class="gt-qh__code">{String(index+1).padStart(2,'0')} / {entry.data.microcode}</p><h2 id={`${entry.data.slug}-title`}>{entry.data.title}</h2><p class="gt-qh__cue">{entry.data.cue}</p><p class="gt-qh__short">{entry.data.shortDescription}</p><div class="gt-qh__body"><Content/></div><a class="gt-qh__archive" href={`/archivo?familia=${entry.data.slug}`}>Ver trayectoria →</a></div></section>)}</div>
<footer class="gt-page-close"><div class="gt-page-close__inner"><p class="gt-page-close__text">Si tienes un problema que todavía no encaja en una categoría, conversemos sobre él.</p><a class="gt-cta" href={conversarHref}>{copy.ctaPrimary}</a></div></footer>
</article>
</BaseLayout>
<style>
.gt-qh{padding-bottom:var(--gt-space-12)}.gt-qh__intro{padding:var(--gt-space-10) 0 var(--gt-space-8);border-bottom:1px solid var(--gt-border)}.gt-qh__micro,.gt-qh__code,.gt-qh__cue{font-family:ui-monospace,SFMono-Regular,Menlo,monospace;letter-spacing:.14em;text-transform:uppercase}.gt-qh__micro{font-size:.62rem;color:var(--gt-gray-400);margin-bottom:.5rem}.gt-qh h1{font-size:var(--gt-fs-xl);margin-bottom:var(--gt-space-4)}.gt-qh__lead{font-size:var(--gt-fs-lg);font-weight:600;max-width:34rem;margin-bottom:var(--gt-space-4)}.gt-qh__support{max-width:44rem;color:var(--gt-text-muted)}.gt-qh__list{padding-top:var(--gt-space-4)}.gt-qh__cap{display:grid;grid-template-columns:minmax(12rem,.65fr) minmax(0,1.35fr);gap:clamp(2rem,6vw,7rem);padding:var(--gt-space-10) 0;border-bottom:1px solid var(--gt-border);scroll-margin-top:calc(var(--gt-header-h) + .75rem);max-width:none}.gt-qh__visual{display:flex;align-items:flex-start;justify-content:center;min-height:12rem;padding:var(--gt-space-5);background:linear-gradient(#e8eceb 1px,transparent 1px),linear-gradient(90deg,#e8eceb 1px,transparent 1px);background-size:28px 28px}.gt-qh__visual :global(.gt-cv){width:min(12rem,70%);height:auto}.gt-qh__copy{max-width:46rem}.gt-qh__code{font-size:.62rem;color:var(--gt-coral);margin:0 0 .65rem}.gt-qh h2{font-size:clamp(1.65rem,1.2rem + 1.4vw,2.5rem);margin-bottom:.35rem}.gt-qh__cue{font-size:.62rem;color:var(--gt-gray-600);margin:0 0 1rem}.gt-qh__short{font-size:var(--gt-fs-md);font-weight:600;margin-bottom:var(--gt-space-4)}.gt-qh__body{color:var(--gt-text-muted);max-width:42rem}.gt-qh__body :global(p){margin:0 0 .85rem}.gt-qh__archive{display:inline-block;margin-top:var(--gt-space-4);font-size:.78rem;letter-spacing:.08em;text-transform:uppercase;text-decoration:none;color:var(--gt-coral)}.gt-qh__cta{padding-top:var(--gt-space-10);max-width:44rem}.gt-qh__cta p{margin-bottom:var(--gt-space-5);color:var(--gt-gray-800)}@media(max-width:720px){.gt-qh__cap{grid-template-columns:1fr;gap:var(--gt-space-5);padding:var(--gt-space-8) 0}.gt-qh__visual{min-height:8rem}.gt-qh__lead{max-width:none}}
</style>