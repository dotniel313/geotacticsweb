---
import { getCollection, render } from 'astro:content';
import CapabilityVisual from '../components/CapabilityVisual.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { capabilitiesIntro, conversarHref, copy } from '../config/site';

const entries = (await getCollection('capabilities')).sort((a, b) => a.data.order - b.data.order);

const rendered = await Promise.all(
	entries.map(async (entry) => {
		const { Content } = await render(entry);
		return { entry, Content };
	}),
);

const seoTitle = 'Qué hacemos | GeoTactics';
const seoDescription =
	'Seis familias de problema GeoTactics: inteligencia territorial, gobierno y gestión, sociedad y participación, operaciones, mercados y turismo.';
---

<BaseLayout title={seoTitle} description={seoDescription} noindex={false}>
	<article class="gt-qh">
		<header class="gt-qh__intro gt-container--wide">
			<p class="gt-qh__micro">{capabilitiesIntro.microcode}</p>
			<h1>Qué hacemos</h1>
			<p class="gt-qh__lead">{capabilitiesIntro.headline}</p>
			<p class="gt-qh__support">{capabilitiesIntro.supporting}</p>
		</header>

		<div class="gt-qh__list gt-container--wide">
			{
				rendered.map(({ entry, Content }) => (
					<section class="gt-qh__cap" id={entry.data.slug} aria-labelledby={`${entry.data.slug}-title`}>
						<div class="gt-qh__cap-head">
							<p class="gt-qh__code">
								{entry.data.microcode}
								<span aria-hidden="true"> · </span>
								{String(entry.data.order).padStart(2, '0')}
							</p>
							<CapabilityVisual kind={entry.data.visual} />
						</div>
						<h2 id={`${entry.data.slug}-title`}>{entry.data.title}</h2>
						<p class="gt-qh__cue">{entry.data.cue}</p>
						<p class="gt-qh__short">{entry.data.shortDescription}</p>
						<div class="gt-qh__body">
							<Content />
						</div>
					</section>
				))
			}
		</div>

		<footer class="gt-qh__cta gt-container--wide">
			<p>
				Estas capacidades se materializan en productos y proyectos. Si el problema está en territorio, gestión,
				operación, mercado o campo, conversemos.
			</p>
			<a class="gt-cta" href={conversarHref}>{copy.ctaPrimary}</a>
		</footer>
	</article>
</BaseLayout>

<style>
	.gt-qh {
		padding-bottom: var(--gt-space-12);
	}

	.gt-qh__intro {
		padding: var(--gt-space-10) 0 var(--gt-space-8);
		border-bottom: 1px solid var(--gt-border);
	}

	.gt-qh__micro,
	.gt-qh__code,
	.gt-qh__cue {
		font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
		letter-spacing: 0.14em;
		text-transform: uppercase;
	}

	.gt-qh__micro {
		font-size: 0.62rem;
		color: var(--gt-gray-400);
		margin-bottom: 0.5rem;
	}

	.gt-qh h1 {
		font-size: var(--gt-fs-xl);
		margin-bottom: var(--gt-space-4);
	}

	.gt-qh__lead {
		font-size: var(--gt-fs-lg);
		font-weight: 600;
		max-width: 28ch;
		margin-bottom: var(--gt-space-4);
	}

	.gt-qh__support {
		max-width: 40rem;
		color: var(--gt-text-muted);
	}

	.gt-qh__list {
		padding-top: var(--gt-space-6);
	}

	.gt-qh__cap {
		padding: var(--gt-space-8) 0;
		border-bottom: 1px solid var(--gt-border);
		scroll-margin-top: calc(var(--gt-header-h) + 0.75rem);
		max-width: 42rem;
	}

	@media (min-width: 721px) and (max-width: 1024px) {
		.gt-qh__lead,
		.gt-qh__support,
		.gt-qh__cap,
		.gt-qh__cta {
			max-width: 46rem;
		}
	}

	@media (max-width: 720px) {
		.gt-qh__list {
			padding-top: var(--gt-space-4);
		}

		.gt-qh__lead {
			max-width: none;
		}
	}

	.gt-qh__cap-head {
		display: flex;
		justify-content: space-between;
		align-items: flex-start;
		margin-bottom: 0.75rem;
	}

	.gt-qh__code {
		font-size: 0.62rem;
		color: var(--gt-gray-400);
		margin: 0;
	}

	.gt-qh h2 {
		font-size: var(--gt-fs-lg);
		margin-bottom: 0.35rem;
	}

	.gt-qh__cue {
		font-size: 0.62rem;
		color: var(--gt-coral);
		margin: 0 0 1rem;
	}

	.gt-qh__short {
		font-weight: 600;
		margin-bottom: var(--gt-space-4);
	}

	.gt-qh__body {
		color: var(--gt-text-muted);
	}

	.gt-qh__body :global(p) {
		margin: 0 0 0.85rem;
	}

	.gt-qh__cta {
		padding-top: var(--gt-space-10);
		max-width: 40rem;
	}

	.gt-qh__cta p {
		margin-bottom: var(--gt-space-5);
		color: var(--gt-gray-800);
	}
</style>
