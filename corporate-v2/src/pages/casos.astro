---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import CaseCard from '../components/CaseCard.astro';
import { conversarHref, copy } from '../config/site';
import { isPublicCase, sortCases } from '../lib/cases';

const entries = sortCases((await getCollection('cases')).filter(isPublicCase));
---

<BaseLayout
	title="Casos | GeoTactics"
	description="Experiencias de GeoTactics en territorio, instituciones, gestión y operación."
	noindex={false}
>
	<article class="gt-ci">
		<header class="gt-ci__intro gt-container--wide">
			<p class="gt-ci__micro">GT / CASES</p>
			<h1>Casos</h1>
			<p class="gt-ci__lead">Problemas reales. Sistemas puestos a trabajar en contextos concretos.</p>
			<p class="gt-ci__support">
				Una selección de experiencias que muestran cómo GeoTactics ha trabajado con territorio,
				información, gestión y operación a lo largo del tiempo.
			</p>
		</header>

		<section class="gt-ci__list gt-container--wide" aria-labelledby="gt-ci-list">
			<h2 id="gt-ci-list">Experiencias</h2>
			<div class="gt-ci__grid">
				{entries.map((entry) => <CaseCard entry={entry} />)}
			</div>
		</section>

		<footer class="gt-page-close">
	\t\t<div class="gt-page-close__inner">
			<p class="gt-page-close__text">Si tienes un problema que necesita convertirse en un sistema útil, conversemos.</p>
			<a class="gt-cta" href={conversarHref}>{copy.ctaPrimary}</a>
		
			</div></footer>
	</article>
</BaseLayout>

<style>
	.gt-ci { padding-bottom: var(--gt-space-12); min-width: 0; max-width: 100%; }
	.gt-ci__intro { padding: var(--gt-space-10) 0 var(--gt-space-8); border-bottom: 1px solid var(--gt-border); }
	.gt-ci__micro { font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: .62rem; letter-spacing: .14em; text-transform: uppercase; color: var(--gt-gray-400); margin-bottom: .5rem; }
	.gt-ci h1 { font-size: var(--gt-fs-xl); margin-bottom: var(--gt-space-4); max-width: 18rem; }
	.gt-ci__lead { font-size: var(--gt-fs-lg); font-weight: 600; max-width: 34rem; margin-bottom: var(--gt-space-4); }
	.gt-ci__support { max-width: 44rem; color: var(--gt-text-muted); }
	.gt-ci__list { padding: var(--gt-space-10) 0; }
	.gt-ci__list h2 { font-size: var(--gt-fs-lg); margin-bottom: var(--gt-space-6); }
	.gt-ci__grid > :first-child { grid-column: 1 / -1; }
	.gt-ci__cta { padding-top: var(--gt-space-8); max-width: 40rem; }
	.gt-ci__cta p { margin-bottom: var(--gt-space-5); }
	@media (max-width:720px){ .gt-ci h1,.gt-ci__lead{max-width:none}.gt-ci__grid{grid-template-columns:1fr} }
</style>
