---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { conversarHref, copy } from '../config/site';
import { newsTypeLabels } from '../data/news';
import TerritorialGrid from '../components/TerritorialGrid.astro';
import launchLogo from '../assets/brand/derived/geotactics-full-light.png';

const entries = (await getCollection('news'))
	.filter((e) => e.data.publicationStatus === 'public')
	.sort((a, b) => +b.data.date - +a.data.date);
---

<BaseLayout
	title="Noticias | GeoTactics"
	description="Signals de GeoTactics: actividad, productos, investigación y actualizaciones. Sin titulares inventados."
	noindex={false}
>
	<article class="gt-nw">
		<header class="gt-nw__intro gt-container--wide">
			<p class="gt-nw__micro">GT / SIGNALS</p>
			<h1>Noticias</h1>
			<p class="gt-nw__lead">Actualizaciones, lanzamientos y momentos que cuentan cómo evoluciona GeoTactics.</p>
		</header>

		{
			entries.length === 0 ? (
				<section class="gt-nw__empty gt-container--wide" aria-labelledby="gt-nw-empty">
					<h2 id="gt-nw-empty">Archivo en construcción</h2>
					<p>
						El archivo de noticias se está construyendo. Cuando haya una nota publicable, aparecerá aquí.
					</p>
				</section>
			) : (
				<ul class="gt-nw__list gt-container--wide">
					{entries.map((entry) => (
						<li>
							<a href={`/noticias/${entry.data.slug}`} class="gt-nw__card">
								{entry.data.heroAsset === 'launch-web-3' ? (
									<div class="gt-nw__thumb" aria-hidden="true">
										<TerritorialGrid intensity="soft" />
										<img src={launchLogo.src} width={launchLogo.width} height={launchLogo.height} alt="" />
										<span>WEB 3.0 · 25 SEP 2026</span>
									</div>
								) : null}
								<div class="gt-nw__copy">
								<p class="gt-nw__type">{newsTypeLabels[entry.data.type]}</p>
								<h2>{entry.data.title}</h2>
								<p>
									<time datetime={entry.data.date.toISOString()}>
										{entry.data.date.toLocaleDateString('es-EC', {
											day: 'numeric',
											month: 'long',
											year: 'numeric',
										})}
									</time>
								</p>
								<p>{entry.data.summary}</p>
								</div>
							</a>
						</li>
					))}
				</ul>
			)
		}

		<footer class="gt-nw__cta gt-container--wide">
			<a class="gt-cta" href={conversarHref}>{copy.ctaPrimary}</a>
		</footer>
	</article>
</BaseLayout>

<style>
	.gt-nw {
		padding-bottom: var(--gt-space-12);
	}

	.gt-nw__intro {
		padding: var(--gt-space-10) 0 var(--gt-space-8);
		border-bottom: 1px solid var(--gt-border);
	}

	.gt-nw__micro {
		font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
		font-size: 0.62rem;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: var(--gt-gray-400);
		margin-bottom: 0.5rem;
	}

	.gt-nw h1 {
		font-size: var(--gt-fs-xl);
		margin-bottom: var(--gt-space-4);
	}

	.gt-nw__lead {
		max-width: 36rem;
		color: var(--gt-text-muted);
	}

	.gt-nw__empty {
		padding: var(--gt-space-10) 0;
		max-width: 40rem;
	}

	.gt-nw__empty h2 {
		font-size: var(--gt-fs-lg);
		margin-bottom: var(--gt-space-4);
	}

	.gt-nw__list {
		list-style: none;
		margin: 0;
		padding: var(--gt-space-10) 0;
	}

	.gt-nw__list a {
		display: block;
		padding: var(--gt-space-5) 0;
		border-bottom: 1px solid var(--gt-border);
		text-decoration: none;
	}

	.gt-nw__card:has(.gt-nw__thumb) {
		display: grid;
		grid-template-columns: minmax(13rem, 0.7fr) minmax(0, 1.3fr);
		gap: var(--gt-space-6);
		align-items: stretch;
	}

	.gt-nw__thumb {
		position: relative;
		min-height: 12rem;
		overflow: hidden;
		border: 1px solid var(--gt-border);
		background: var(--gt-off-white);
		display: grid;
		place-items: center;
		padding: var(--gt-space-5);
		isolation: isolate;
	}

	.gt-nw__thumb img {
		position: relative;
		z-index: 2;
		width: min(78%, 18rem);
		height: auto;
		mix-blend-mode: multiply;
	}

	.gt-nw__thumb span {
		position: absolute;
		left: var(--gt-space-4);
		bottom: var(--gt-space-4);
		z-index: 2;
		font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
		font-size: 0.62rem;
		letter-spacing: 0.12em;
		color: var(--gt-coral);
	}

	.gt-nw__copy {
		align-self: center;
	}

	.gt-nw__type {
		font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
		font-size: 0.62rem;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--gt-coral);
		margin-bottom: 0.35rem;
	}

	.gt-nw__cta {
		padding-top: var(--gt-space-6);
	}

	@media (max-width: 720px) {
		.gt-nw__card:has(.gt-nw__thumb) {
			grid-template-columns: 1fr;
		}
		.gt-nw__thumb {
			min-height: 10rem;
		}
	}
</style>
