---
interface Props {
	intensity?: 'hero' | 'subtle';
}

const { intensity = 'subtle' } = Astro.props;
---

<div class:list={['gt-grid', intensity === 'hero' && 'gt-grid--hero']} aria-hidden="true"></div>

<style>
	.gt-grid {
		pointer-events: none;
		position: absolute;
		inset: 0;
		background-image:
			linear-gradient(to right, color-mix(in srgb, var(--gt-coffee) 6%, transparent) 1px, transparent 1px),
			linear-gradient(to bottom, color-mix(in srgb, var(--gt-coffee) 6%, transparent) 1px, transparent 1px);
		background-size: var(--gt-grid-size) var(--gt-grid-size);
		mask-image: radial-gradient(ellipse 70% 65% at 78% 42%, #000 10%, transparent 72%);
		opacity: 0.32;
	}

	.gt-grid--hero {
		opacity: 0.48;
		mask-image: linear-gradient(90deg, transparent 0%, transparent 38%, #000 78%);
	}

	@media (prefers-reduced-motion: reduce) {
		.gt-grid {
			opacity: 0.28;
		}
	}
</style>
