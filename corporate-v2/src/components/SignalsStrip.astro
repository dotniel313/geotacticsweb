---
import { getCollection } from 'astro:content';

const published = (await getCollection('news'))
	.filter((entry) => entry.data.publicationStatus === 'public')
	.sort((a, b) => +b.data.date - +a.data.date)
	.slice(0, 4);

const empty = published.length === 0;
const fmt = (d: Date) => d.toLocaleDateString('es-EC', { day: '2-digit', month: 'short', year: 'numeric' });
---

<div class:list={['gt-signals', empty && 'gt-signals--empty']} aria-label="GeoTactics Signals">
	{
		empty ? (
			<div class="gt-signals__inner gt-container--wide">
				<p class="gt-signals__empty">
					<span class="gt-signals__id">GEOTACTICS / SIGNALS</span>
					<span class="gt-signals__title">Archivo en construcción. No hay entradas publicables.</span>
					<a class="gt-signals__more" href="/noticias">Noticias</a>
				</p>
			</div>
		) : (
			<div class="gt-signals__viewport">
				<div class="gt-signals__track">
					<div class="gt-signals__group">
						{published.map((entry, i) => (
							<a class="gt-signals__item" href={`/noticias/${entry.data.slug}`}>
								<span class="gt-signals__id">SIGNALS / {String(i + 1).padStart(3, '0')}</span>
								<span class="gt-signals__title">{entry.data.title}</span>
								<time datetime={entry.data.date.toISOString()}>{fmt(entry.data.date)}</time>
								<span class="gt-signals__arrow" aria-hidden="true">→</span>
							</a>
						))}
					</div>
					<div class="gt-signals__group" aria-hidden="true">
						{published.map((entry, i) => (
							<a class="gt-signals__item" href={`/noticias/${entry.data.slug}`} tabindex="-1">
								<span class="gt-signals__id">SIGNALS / {String(i + 1).padStart(3, '0')}</span>
								<span class="gt-signals__title">{entry.data.title}</span>
								<time>{fmt(entry.data.date)}</time>
								<span class="gt-signals__arrow">→</span>
							</a>
						))}
					</div>
				</div>
			</div>
		)
	}
</div>

<style>
	.gt-signals {
		position: sticky;
		top: var(--gt-header-h);
		z-index: var(--gt-z-signals);
		background: var(--gt-coral);
		color: var(--gt-white);
		min-height: var(--gt-signals-h);
		display: flex;
		align-items: center;
		overflow: hidden;
	}

	.gt-signals__inner {
		width: 100%;
	}

	.gt-signals__empty {
		display: grid;
		grid-template-columns: auto minmax(0, 1fr) auto;
		gap: var(--gt-space-4);
		align-items: center;
		min-height: var(--gt-signals-h);
		margin: 0;
		color: var(--gt-white);
		font-size: 0.82rem;
		font-weight: 600;
	}

	.gt-signals__viewport {
		width: 100%;
		overflow: hidden;
	}

	.gt-signals__track {
		display: flex;
		width: max-content;
		min-width: 100%;
		animation: gt-signals-marquee 34s linear infinite;
		will-change: transform;
	}

	.gt-signals__group {
		display: flex;
		align-items: center;
		flex-shrink: 0;
	}

	.gt-signals__item {
		display: inline-flex;
		align-items: center;
		gap: 0.9rem;
		min-height: var(--gt-signals-h);
		padding: 0 2rem;
		color: var(--gt-white);
		text-decoration: none;
		white-space: nowrap;
		border-right: 1px solid color-mix(in srgb, white 28%, transparent);
		font-size: 0.82rem;
	}

	.gt-signals__item:focus-visible {
		outline: 2px solid var(--gt-white);
		outline-offset: -4px;
	}

	.gt-signals__id {
		letter-spacing: 0.14em;
		font-size: 0.68rem;
		font-weight: 700;
		opacity: 0.9;
	}

	.gt-signals__title {
		font-weight: 600;
		border-bottom: 1px dotted color-mix(in srgb, white 50%, transparent);
	}

	.gt-signals__item time,
	.gt-signals__arrow {
		font-size: 0.74rem;
		font-variant-numeric: tabular-nums;
		opacity: 0.88;
	}

	.gt-signals:hover .gt-signals__track,
	.gt-signals:focus-within .gt-signals__track {
		animation-play-state: paused;
	}

	.gt-signals__more {
		color: inherit;
		white-space: nowrap;
		font-size: 0.75rem;
	}

	@keyframes gt-signals-marquee {
		from { transform: translateX(0); }
		to { transform: translateX(-50%); }
	}

	@media (prefers-reduced-motion: reduce) {
		.gt-signals__track {
			animation: none;
			overflow-x: auto;
			max-width: 100vw;
		}
		.gt-signals__group[aria-hidden='true'] {
			display: none;
		}
	}

	@media (max-width: 720px) {
		.gt-signals__item {
			padding-inline: 1.25rem;
			gap: 0.65rem;
		}
		.gt-signals__item time {
			display: none;
		}
		.gt-signals__empty {
			grid-template-columns: 1fr auto;
			gap: 0.4rem;
		}
		.gt-signals__empty .gt-signals__id {
			grid-column: 1 / -1;
		}
	}
</style>
