---
import headerLogo from '../assets/brand/derived/geotactics-header.png';
import { conversarHref, conversarLabel, navItems, site } from '../config/site';
import { contact, mailtoHref } from '../data/contact';

const year = new Date().getFullYear();
---

<footer class="gt-foot">
	<div class="gt-foot__grid gt-container--wide">
		<div class="gt-foot__brand">
			<a class="gt-brand" href="/" aria-label="GeoTactics, inicio">
				<img src={headerLogo.src} width={headerLogo.width} height={headerLogo.height} alt="" />
			</a>
			<p class="gt-foot__desc">Sistemas que conectan territorio, datos y operación.</p>
			<p class="gt-foot__heritage">
				<span>Identidad histórica</span>
				Data / Warehouse - Mart
			</p>
		</div>
		<nav aria-label="Pie de sitio">
			<p class="gt-foot__h">Sitio</p>
			<ul>
				{navItems.map((item) => (
					<li>
						<a href={item.href}>{item.label}</a>
					</li>
				))}
				<li>
					<a href="/noticias">Noticias</a>
				</li>
				<li>
					<a href={conversarHref}>{conversarLabel}</a>
				</li>
			</ul>
		</nav>
		<div>
			<p class="gt-foot__h">Base</p>
			<p>
				{contact.baseCity}
				<br />
				{contact.baseProvince}
				<br />
				{contact.baseRegion}
			</p>
			<p class="gt-foot__mail">
				<a href={mailtoHref}>{contact.email}</a>
			</p>
			<p class="gt-foot__legal-links">
				<a href="/privacidad">Privacidad</a>
				<span aria-hidden="true"> · </span>
				<a href="/legal">Legal</a>
			</p>
		</div>
	</div>
	<p class="gt-foot__copy gt-container--wide">© {year} {site.name}. Nueva Loja, Ecuador.</p>
</footer>

<style>
	.gt-foot {
		margin-top: var(--gt-space-8);
		padding: var(--gt-space-10) 0 var(--gt-space-6);
		border-top: 1px solid var(--gt-border);
		background: var(--gt-white);
		color: var(--gt-gray-800);
	}

	.gt-foot__grid {
		display: grid;
		grid-template-columns: minmax(0, 1.4fr) repeat(2, minmax(0, 1fr));
		gap: var(--gt-space-8);
		align-items: start;
	}

	.gt-foot__brand .gt-brand img {
		display: block;
		height: 36px;
		width: auto;
		max-width: min(12rem, 100%);
	}

	.gt-foot__brand,
	.gt-foot__grid > * {
		min-width: 0;
	}

	.gt-foot__desc {
		margin: var(--gt-space-4) 0;
		max-width: 22rem;
	}

	.gt-foot__heritage {
		font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
		font-size: 0.72rem;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--gt-coffee);
		margin-bottom: 0.35rem;
	}

	.gt-foot__heritage span {
		display: block;
		color: var(--gt-coral);
		letter-spacing: 0.16em;
	}

	.gt-foot__heritage-note {
		font-size: var(--gt-fs-xs);
		color: var(--gt-gray-400);
		max-width: 22rem;
	}

	.gt-foot__h {
		font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
		font-size: 0.62rem;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: var(--gt-gray-400);
		margin-bottom: var(--gt-space-3);
	}

	.gt-foot ul {
		list-style: none;
		margin: 0;
		padding: 0;
	}

	.gt-foot li {
		margin-bottom: 0.4rem;
	}

	.gt-foot a {
		text-decoration: none;
	}

	.gt-foot a:hover {
		text-decoration: underline;
	}

	.gt-foot__mail {
		margin-top: var(--gt-space-4);
	}

	.gt-foot__legal-links {
		margin-top: var(--gt-space-4);
		font-size: var(--gt-fs-sm);
	}

	.gt-foot__copy {
		margin-top: var(--gt-space-8);
		padding-top: var(--gt-space-4);
		border-top: 1px solid var(--gt-border);
		font-size: var(--gt-fs-xs);
		color: var(--gt-gray-400);
	}

	@media (max-width: 1024px) {
		.gt-foot__grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}

	@media (max-width: 720px) {
		.gt-foot__grid {
			grid-template-columns: 1fr;
			gap: var(--gt-space-6);
		}
	}
</style>
