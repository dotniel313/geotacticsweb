---
import { families, familyById } from '../data/taxonomy';
import { mappableRecords, type RecordKind } from '../data/records';
import { site } from '../config/site';
import type { TerritoryPin } from '../scripts/territory-mode';
import 'leaflet/dist/leaflet.css';

const kindLabel: Record<RecordKind, string> = {
	product: 'Producto',
	case: 'Caso',
	component: 'Componente',
	prototype: 'Prototipo',
	experience: 'Experiencia',
};

const pins: TerritoryPin[] = mappableRecords().flatMap((r) =>
	(r.coordinates ?? []).map((coordinate, index) => ({
		slug: index === 0 ? r.slug : `${r.slug}-${index + 1}`,
		recordSlug: r.slug,
		title: r.title,
		yearLabel: r.yearLabel,
		kind: r.kind,
		kindLabel: kindLabel[r.kind],
		family: r.primaryFamily,
		familyTitle: familyById(r.primaryFamily).title,
		color: familyById(r.primaryFamily).color,
		territory: coordinate.label ?? r.territory,
		note: coordinate.note,
		lat: coordinate.lat,
		lng: coordinate.lng,
		detailHref: r.detailHref,
	}))
);

const hq = { lat: 0.091, lng: -76.89, label: `GeoTactics · ${site.originLine}` };
---

<section class="gt-tm" aria-labelledby="gt-tm-h">
	<header class="gt-tm__head gt-container--wide">
		<p class="gt-tm__micro">GT / OPERACIÓN TERRITORIAL</p>
		<h1 id="gt-tm-h">Operación territorial</h1>
		<p class="gt-tm__lead">
			Una lectura espacial de la trayectoria: proyectos e implementaciones vistos desde el territorio.
		</p>
		<div class="gt-tm__filters" aria-label="Filtrar mapa por familia">
			<button type="button" class="gt-tm__filter is-active" data-territory-all aria-pressed="true">
				<span class="gt-tm__swatch gt-tm__swatch--all"></span>Todos
			</button>
			{families.map((family) => {
				const count = pins.filter((pin) => pin.family === family.id).length;
				return (
					<button
						type="button"
						class="gt-tm__filter is-active"
						data-territory-family={family.id}
						aria-pressed="true"
						disabled={count === 0}
						style={`--gt-map-family:${family.color}`}
					>
						<span class="gt-tm__swatch"></span>{family.title}<em>{count}</em>
					</button>
				);
			})}
		</div>
	</header>
	<div class="gt-tm__frame">
		<div class="gt-tm__canvas" id="gt-tm-map" role="application" aria-label="Mapa territorial GeoTactics"></div>
		<p class="gt-tm__attr">
			© <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors
		</p>
	</div>
	<div class="gt-tm__alt gt-container--wide">
		<h2>Registros con coordenadas</h2>
		<ul>
			{
				pins.map((p) => (
					<li>
						<a href={`/archivo?familia=${p.family}&hito=${p.recordSlug}`}>
							<span>{p.territory}</span>
							<strong>{p.title}</strong>
							<em>{p.yearLabel}</em>
						</a>
						{p.detailHref && (
							<a class="gt-tm__d" href={p.detailHref}>
								{p.kindLabel}
							</a>
						)}
					</li>
				))
			}
		</ul>
	</div>
</section>

<script type="application/json" data-gt-territory set:html={JSON.stringify({ pins, hq })} />

<script>
	import { initTerritory } from '../scripts/territory-mode';

	const node = document.querySelector<HTMLScriptElement>('[data-gt-territory]');
	const canvas = document.getElementById('gt-tm-map');
	if (node?.textContent && canvas) {
		const payload = JSON.parse(node.textContent);
		initTerritory(canvas, payload.pins, payload.hq);
	}
</script>

<style>
	.gt-tm {
		padding-bottom: calc(var(--gt-space-10) + env(safe-area-inset-bottom, 0px));
	}

	.gt-tm__head {
		padding: var(--gt-space-6) 0 var(--gt-space-5);
	}

	.gt-tm__micro {
		font-family: ui-monospace, Menlo, monospace;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		font-size: 0.62rem;
		color: var(--gt-gray-400);
		margin: 0 0 0.35rem;
	}

	.gt-tm h1 {
		font-size: var(--gt-fs-xl);
		margin: 0 0 0.4rem;
	}

	.gt-tm__lead {
		max-width: 38rem;
		color: var(--gt-text-muted);
		margin: 0;
	}

	.gt-tm__nav {
		margin: 0.85rem 0 0;
	}

	.gt-tm__nav a {
		font-size: 0.78rem;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		text-decoration: none;
		border-bottom: 1px solid var(--gt-coral);
	}


	.gt-tm__filters {
		display: flex;
		flex-wrap: wrap;
		gap: 0.45rem 0.55rem;
		margin-top: var(--gt-space-5);
		max-width: 64rem;
	}
	.gt-tm__filter {
		display: inline-flex;
		align-items: center;
		gap: 0.45rem;
		min-height: 2.15rem;
		padding: 0.35rem 0.6rem;
		border: 1px solid var(--gt-border);
		background: var(--gt-white);
		color: var(--gt-gray-800);
		font-size: 0.72rem;
		cursor: pointer;
	}
	.gt-tm__filter em {
		font-style: normal;
		color: var(--gt-gray-400);
		font-family: ui-monospace, Menlo, monospace;
	}
	.gt-tm__filter:not(.is-active) { opacity: 0.42; }
	.gt-tm__filter:disabled { opacity: 0.25; cursor: default; }
	.gt-tm__swatch {
		width: 0.58rem;
		height: 0.58rem;
		background: var(--gt-map-family, var(--gt-coral));
		display: inline-block;
	}
	.gt-tm__swatch--all { background: var(--gt-gray-950); }

	.gt-tm__frame {
		border-block: 1px solid var(--gt-border);
		background: var(--gt-white);
	}

	.gt-tm__canvas {
		width: 100%;
		height: min(70vh, 38rem);
		min-height: 18rem;
		background: var(--gt-gray-100);
	}

	.gt-tm__canvas :global(.leaflet-layer) {
		filter: grayscale(100%) contrast(1.08);
	}

	.gt-tm__attr {
		font-size: 0.72rem;
		color: var(--gt-gray-600);
		padding: 0.45rem 0.75rem;
	}

	.gt-tm__alt {
		padding-top: var(--gt-space-8);
	}

	.gt-tm__alt h2 {
		font-size: 0.78rem;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		margin-bottom: var(--gt-space-4);
	}

	.gt-tm__alt ul {
		list-style: none;
		margin: 0;
		padding: 0;
		border-top: 1px solid var(--gt-border);
	}

	.gt-tm__alt li {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem 1rem;
		align-items: center;
		border-bottom: 1px solid var(--gt-border);
		min-height: var(--gt-touch);
	}

	.gt-tm__alt a {
		text-decoration: none;
		display: grid;
		grid-template-columns: minmax(0, 1.2fr) minmax(0, 1.4fr) auto;
		gap: 0.75rem;
		flex: 1;
		padding: 0.85rem 0;
		min-width: 0;
		align-items: center;
	}

	.gt-tm__alt span {
		font-size: 0.72rem;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: var(--gt-coral);
	}

	.gt-tm__d {
		flex: 0 0 auto !important;
		display: inline !important;
		font-size: 0.72rem;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--gt-gray-800);
	}

	:global(.gt-pin) {
		background: transparent;
	}

	:global(.gt-pin span) {
		display: block;
		width: 12px;
		height: 12px;
		border-radius: 50%;
		background: var(--gt-pin-family, var(--gt-gray-800));
		border: 2px solid var(--gt-white);
		box-shadow: 0 1px 4px color-mix(in srgb, var(--gt-gray-950) 25%, transparent);
	}

	:global(.gt-pin--hq span) {
		width: 14px;
		height: 14px;
		background: var(--gt-gray-950);
		border-color: var(--gt-white);
	}

	:global(.gt-tpopwrap .leaflet-popup-content-wrapper) {
		background: var(--gt-gray-950);
		color: #f4f7f6;
		border-radius: 2px;
		box-shadow: none;
		padding: 0.35rem 0.2rem;
	}

	:global(.gt-tpopwrap .leaflet-popup-tip) {
		background: var(--gt-gray-950);
	}

	:global(.gt-tpop) {
		font-size: 0.82rem;
		line-height: 1.4;
		min-width: 12rem;
	}

	:global(.gt-tpop p) {
		margin: 0 0 0.25rem;
	}

	:global(.gt-tpop__k) {
		font-family: ui-monospace, Menlo, monospace;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		font-size: 0.62rem;
		color: #e84c3d;
	}

	:global(.gt-tpop__t) {
		font-weight: 700;
	}

	:global(.gt-tpop__n) {
		color: #c5c9cc;
		font-size: 0.75rem;
	}

	:global(.gt-tpop__acts) {
		display: flex;
		flex-wrap: wrap;
		gap: 0.65rem;
		margin-top: 0.45rem;
	}

	:global(.gt-tpop__a) {
		color: #e84c3d;
		text-decoration: none;
		border-bottom: 1px solid #e84c3d;
		font-size: 0.72rem;
		letter-spacing: 0.06em;
		text-transform: uppercase;
	}

	@media (max-width: 720px) {
		.gt-tm__alt a {
			grid-template-columns: 1fr;
			gap: 0.2rem;
		}
	}
</style>
